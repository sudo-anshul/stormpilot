FROM node:22-bookworm-slim AS web
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci
COPY web ./web
RUN npm run build && npm prune --omit=dev

FROM python:3.12-slim-bookworm AS native
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*
COPY engine ./engine
RUN python3 engine/build.py

FROM python:3.12-slim-bookworm
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 && rm -rf /var/lib/apt/lists/*
COPY --from=web /usr/local/bin/node /usr/local/bin/node
COPY --from=web /app/node_modules ./node_modules
COPY --from=web /app/web/dist ./web/dist
COPY --from=native /app/engine ./engine
COPY validation ./validation
COPY evaluation ./evaluation
COPY service ./service
COPY fixtures ./fixtures
COPY docs ./docs
COPY scripts/blob.mjs ./scripts/blob.mjs
COPY LICENSE server.py cloud_server.py package.json ./
RUN useradd --create-home stormpilot && chown -R stormpilot:stormpilot /app
USER stormpilot
ENV PORT=8000 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
EXPOSE 8000
CMD ["python3", "cloud_server.py"]
